vars: @./_palette

direction: right

decl: "Одно объявление роли\n(consent + window)\n+ один скрипт стража\nиз скилла safety-guard"
claude: "claude:\nPreToolUse; ask и updatedInput\nдоезжают до поверхности"
codex: "codex:\nPreToolUse / PermissionRequest /\nPostToolUse через адаптер.\nupdatedInput НЕ форвардится,\nask на PreToolUse → deny"
agy: "agy:\nPreToolUse; ответ в ключе\nCommandLine, не command"
cline: "cline:\nканала рантайм-хуков НЕТ\n(база возвращает no-op)"
ask: "Вопрос в чате → билет → грант"
env: "AI_HATS_CONSENT при запуске:\nта же грамматика, тот же грант,\nвыдаёт запускающее окружение" {shape: parallelogram}
engine: "Движок отказывает одинаково\nна всех четырёх"

decl -> claude
decl -> codex
decl -> agy
decl -> cline
claude -> ask
agy -> ask
codex -> env: билет не доезжает
cline -> env: спросить некого
ask -> engine
env -> engine
