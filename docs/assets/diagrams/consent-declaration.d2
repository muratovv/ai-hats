vars: @./_palette

direction: down

decl: "Роль / трейт, config.yaml:\ncomposition.apps.rack.tasks:\n  - at: [edge:review--done]\n    consent: true\n    window: 20m"
merge: "Композиция:\nстроки трейтов и роли\nсливаются, последний писавший\nвыигрывает — consent: false\nвыключает точку"
result: "CompositionResult\n(frozen)"
json: "role_materialization.json\nв каталоге сессии:\nconsent: [{app, path, point,\ndeclared_by, window}]" {shape: cylinder}
hook: "Страж (stdlib-хук):\nчитает JSON по пути из\nAI_HATS_SESSION_IDENTITY\n→ на каких точках спрашивать"
engine: "Движок (in-process):\nresolve_consent_points\nперечитывает библиотеку\n→ на каких точках отказывать"

decl -> merge
merge -> result
result -> json: сохраняется при старте сессии
json -> hook
result -> engine: тот же состав, другой путь резолва
