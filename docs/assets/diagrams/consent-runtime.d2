vars: @./_palette

direction: down

cmd: "Агент: rack transition HATS-1 done"
gate: "PreToolUse-цепочка → safety_gate:\nточка объявлена ролью?"
plain: Обычный поток разрешений
grant_q: "Есть живой грант, покрывающий\n(карточка, операция, сейчас)?"
pass: "Вопроса нет.\nСтрока в bypasses.jsonl:\nчем именно разрешено"
mint: "Чеканится одноразовый билет,\nкоманда переписывается:\nAI_HATS_CONSENT_TICKET=<nonce>"
ask: "Вопрос супервизору в чате:\nход, радиус окна и срок"
no: "Нет: команда не исполняется.\nБилет остаётся нетронутым —\nоткрывать нечего"
run: Команда исполняется
inlock: "rack, in-lock ConsentExtension:\nбилет или грант — иначе отказ"
move: Переход состоялся
spend: "rack, post-lock ConsentSpend:\nход по билету — билет тратится\nи пишется грант на окно роли;\nход по гранту — только строка журнала"
store: "Хранилище в git-каталоге:\nграмматика куда:что:до-когда,\n* развёрнут при выдаче" {shape: cylinder}

cmd -> gate
gate -> plain: нет
gate -> grant_q: да
grant_q -> pass: да
pass -> run
grant_q -> mint: нет
mint -> ask
ask -> no: "«Нет»"
ask -> run: "«Да»"
run -> inlock
inlock -> move
move -> spend
spend -> store
store -> grant_q: следующий ход в пределах окна
