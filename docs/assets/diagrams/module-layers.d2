vars: @./_palette

direction: down

# Целевая иерархия модулей, ред. 5 (2026-08-21, HATS-1780).
# ЭТО ПРОЕКЦИЯ канонической adjacency-таблицы ADR-0026 D3; при расхождении
# права таблица, а не рисунок. Ред. 4 разошлась с ней и была перерисована.
# Один узел = один целевой модуль. Стрелка = «зависит от».
# Оранжевым — модуль, которого сегодня НЕ существует.

legend: ЛЕГЕНДА\nсплошная X → Y: X зависит от Y\nпунктир: порт или отданная политика — зависимостью НЕ является\nоранжевое: модуля сегодня не существует\nрёбра «→ core» и «→ project» не рисуются: их имеет почти каждый модуль {
  shape: page
  style.fill: "#ebeef4"
  style.stroke: "#a2acbf"
}

cli: корень композиции ai_hats/cli (C18)\nсток логирования: сегодня НЕ настроен
init: init (C17) — конфигурация проекта\nвладеет конвертом ai-hats.yaml и его schema_version {
  style.fill: "#e8632b"
  style.font-color: "#faf2e6"
}
install: install (C14) — интерпретатор и починка\n_bootstrap живёт на stdlib {
  style.fill: "#e8632b"
  style.font-color: "#faf2e6"
}
channel: channel (C11) — канал обновлений {
  style.fill: "#e8632b"
  style.font-color: "#faf2e6"
}
project: project (C1) — СПИНА\nсобирается раз на точке входа, всё ниже получает {
  style.fill: "#e8632b"
  style.font-color: "#faf2e6"
  style.stroke: "#b54818"
}

pipeline: pipeline (C9) — ПИЛОТ\nдиспетчер один, второго пути нет
reflection: reflection — прикладной workflow\nне модуль: аудиторы, гипотезы, пропозалы поверх C9 {
  style.fill: "#f5e8d0"
  style.stroke: "#c9bba0"
}
runtime: runtime (C19) — исполнение сессии\nHITL и non-HITL · PTY · сигналы · объявляет порт Workspace
observe: observe (C12) — наблюдаемость\nобъявляет политику хранения
providers: providers (C8) — узкие порты\nсвои поверхности внутри ai-hats, чужие через entry points
composition: composition (C4) — политика отказа параметром
mat: materialization (C3) — контракт записи и УЧЁТА\nне файловый шлюз: пишет владелец поддерева
hooks: hooks (C2) — вердикт из каждого канала {
  style.fill: "#e8632b"
  style.font-color: "#faf2e6"
}
reclaim: reclaim (C15) — ТОЛЬКО механизм сверки\nполитику истечения получает объектом {
  style.fill: "#e8632b"
  style.font-color: "#faf2e6"
}
reporting: reporting (C20) — диагностика и починка\nтипизированный контракт НАДО ОПРЕДЕЛИТЬ {
  style.fill: "#e8632b"
  style.font-color: "#faf2e6"
  style.stroke: "#b54818"
}
locks: locks (C5) — ярусы и их бюджеты\nвладелец не назначен: бюджеты объявлены порознь {
  style.fill: "#e8632b"
  style.font-color: "#faf2e6"
}

rack: ai-hats-rack (C7) — эффекты бэклога\nединственная способность, владеющая собой сегодня
library: ai-hats-library (C10) — движок консента\nданные ролей и скиллов · зависимостей нет
wt: ai-hats-wt — движок worktree\nспособности в C1–C20 нет {
  style.fill: "#bac4d8"
}
core: ai-hats-core — ФУНДАМЕНТ\nC13 deadline · C16 механизм обратимости\nC6 словарь идентичности — НЕ ХВАТАЕТ {
  style.fill: "#e8632b"
  style.font-color: "#faf2e6"
  style.stroke: "#b54818"
}

reflection -> pipeline
pipeline -> runtime
runtime -> providers
runtime -> mat
runtime -> hooks
runtime -> observe
runtime -> locks
mat -> composition
mat -> library: только хуки из library
composition -> library
install -> channel
reporting -> channel
wt -> runtime: реализует порт Workspace {style.stroke-dash: 4; style.stroke: "#e8632b"}
observe -> reclaim: ОТДАЁТ политику хранения,\nне наоборот {style.stroke-dash: 4}
rack -> core: целевое ребро —\nсегодня rack от core НЕ зависит {style.stroke: "#e8632b"}
wt -> core
cli -> core
project -> core
